#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() {
    FILE *fp;
    char id[20], name[100], section[30], input[10];
    int choice;

    do {
        printf("Enter Student Number: ");
        fgets(id, sizeof(id), stdin);
        id[strcspn(id, "\n")] = '\0';          /* remove newline */

        printf("Enter Complete Name: ");
        fgets(name, sizeof(name), stdin);
        name[strcspn(name, "\n")] = '\0';

        printf("Enter Section: ");
        fgets(section, sizeof(section), stdin);
        section[strcspn(section, "\n")] = '\0';

        /* Append mode: keeps old records */
        fp = fopen("student_records.txt", "a");
        if (fp == NULL) {
            printf("Error opening file.\n");
            return 1;
        }
        fprintf(fp, "ID Number: %s\nComplete Name: %s\nSection: %s\n\n",
                id, name, section);
        fclose(fp);

        printf("\nRecord added and saved successfully.\n");

        printf("\nAdd another student? [Enter 1 for Yes, 0 for No]: ");
        fgets(input, sizeof(input), stdin);
        choice = atoi(input);

        if (choice == 1)
            printf("\n");
    } while (choice == 1);

    printf("\nAll student records have been saved.\n");
    return 0;
}
